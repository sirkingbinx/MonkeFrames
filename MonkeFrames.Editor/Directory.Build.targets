<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<Target Name="CopyFilesToBuild" AfterTargets="Build">
		<ItemGroup>
			<AssembliesToCopy Include="$(OutputPath)\MonkeFrames.Compiler.dll" />
			<AssembliesToCopy Include="$(OutputPath)\MonkeFrames.Editor.dll" />
			<AssembliesToCopy Include="Build\Dependencies\ffmpeg.exe" />
			<AssembliesToCopy Include="Build\Dependencies\README.txt" />
		</ItemGroup>
		
		<Copy SourceFiles="@(AssembliesToCopy)" DestinationFolder="Build\latest"/>
		<Message Text="Copied assemblies to build folder -> Build\latest" Importance="high"/>
	</Target>

	<Target Name="ZipBuildOutput" AfterTargets="Build">
		<ZipDirectory
			SourceDirectory="Build\latest\"
			DestinationFile="Build\MonkeFrames.zip"
			Overwrite="true" />
	</Target>

	<Target Name="InstallToPlugins" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\plugins')">
		<ItemGroup>
			<MonkeFramesAssemblies Include="Build\latest\*" />
		</ItemGroup>
		
		<Copy
			  SourceFiles="@(MonkeFramesAssemblies)"
			  DestinationFolder="$(GamePath)\BepInEx\plugins\MonkeFrames\"/>
		
		<Message Text="MonkeFrames installed to plugins" Importance="high"/>
	</Target>
</Project>
